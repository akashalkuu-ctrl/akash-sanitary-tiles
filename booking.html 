
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>বুকিং | আকাশ স্যানিটারি ও টাইলস মিস্ত্রি</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#172033}
header{background:#075985;color:white;padding:22px 15px;text-align:center}
header h2{margin:0 0 8px}
.container{max-width:600px;margin:22px auto;padding:20px;background:white;border-radius:14px;box-shadow:0 4px 15px #0001}
h3{color:#075985}
input,select,textarea{width:100%;padding:13px;margin:7px 0 13px;border:1px solid #cbd5e1;border-radius:8px;font-size:15px}
label{font-weight:bold}
button{width:100%;padding:14px;background:#0284c7;color:white;border:0;border-radius:8px;font-size:17px;font-weight:bold}
a{color:#0284c7}
#result{display:none;background:#ecfdf5;padding:15px;border-radius:8px;margin-top:15px}
</style>
</head>
<body>

<header>
<h2>আকাশ স্যানিটারি ও টাইলস মিস্ত্রি</h2>
<p>অনলাইনে কাজের জন্য বুকিং করুন</p>
</header>

<div class="container">
<h3>নতুন বুকিং ফর্ম</h3>

<form id="bookingForm">
<label>আপনার নাম</label>
<input id="name" required placeholder="আপনার নাম">

<label>মোবাইল নম্বর</label>
<input id="phone" required type="tel" placeholder="01XXXXXXXXX">

<label>জেলা</label>
<input id="district" required value="নাটোর">

<label>উপজেলা</label>
<select id="upazila" required>
<option value="">উপজেলা নির্বাচন করুন</option>
<option>নাটোর সদর</option>
<option>লালপুর</option>
<option>বাগাতিপাড়া</option>
<option>বড়াইগ্রাম</option>
<option>গুরুদাসপুর</option>
<option>সিংড়া</option>
<option>নলডাঙ্গা</option>
</select>

<label>গ্রাম / এলাকার নাম</label>
<input id="village" required placeholder="গ্রামের নাম">

<label>সম্পূর্ণ ঠিকানা</label>
<textarea id="address" required placeholder="বাড়ি, রাস্তা ও পরিচিত স্থান"></textarea>

<label>কোন কাজ করাতে চান?</label>
<select id="service" required>
<option value="">কাজ নির্বাচন করুন</option>
<option>স্যানিটারি কাজ</option>
<option>পানির পাইপলাইন</option>
<option>টাইলস মিস্ত্রির কাজ</option>
<option>বাথরুম তৈরি / মেরামত</option>
<option>অন্যান্য</option>
</select>

<label>কাজ দেখার সম্ভাব্য তারিখ</label>
<input id="date" type="date" required>

<label>অতিরিক্ত বিবরণ</label>
<textarea id="details" placeholder="কাজ সম্পর্কে বিস্তারিত লিখুন"></textarea>

<button type="submit" id="submitBtn">বুকিং জমা দিন</button>
</form>

<div id="result">
<h3>বুকিং জমা হয়েছে!</h3>
<p>আপনার বুকিং আইডি:</p>
<strong id="bookingId"></strong>
<p>এই আইডিটি সংরক্ষণ করুন।</p>
</div>

<hr>
<h3>বুকিং স্ট্যাটাস দেখুন</h3>
<input id="trackId" placeholder="আপনার বুকিং আইডি">
<button type="button" onclick="trackBooking()">স্ট্যাটাস দেখুন</button>
<p id="trackResult"></p>

<p><a href="index.html">← মূল ওয়েবসাইটে ফিরে যান</a></p>
</div>

<script type="module">
import {initializeApp} from
"https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";

import {
getFirestore, doc, writeBatch, getDoc, serverTimestamp
} from
"https://www.gstatic.com/firebasejs/11.10.0/firebase-firestore.js";

const firebaseConfig = {
apiKey: "AIzaSyBvDv-zJbn5tgFrTt0Y2XHhagRqpL1YPOo",
authDomain: "akash-sanitary-18f8e.firebaseapp.com",
projectId: "akash-sanitary-18f8e",
storageBucket: "akash-sanitary-18f8e.firebasestorage.app",
messagingSenderId: "356604373846",
appId: "1:356604373846:web:d12ac29c648258668b44f7"
};

const app=initializeApp(firebaseConfig);
const db=getFirestore(app);

const $=id=>document.getElementById(id);

$("bookingForm").addEventListener("submit",async e=>{
e.preventDefault();

const btn=$("submitBtn");
btn.disabled=true;
btn.textContent="জমা হচ্ছে...";

try{
const id="AKS"+Date.now().toString(36).toUpperCase()+
Math.random().toString(36).substring(2,7).toUpperCase();

const data={
id,
name:$("name").value.trim(),
phone:$("phone").value.trim(),
district:$("district").value.trim(),
upazila:$("upazila").value,
village:$("village").value.trim(),
address:$("address").value.trim(),
service:$("service").value,
date:$("date").value,
details:$("details").value.trim(),
status:"নতুন বুকিং",
visitDate:"",
visitTime:"",
note:"",
createdAt:serverTimestamp()
};

const batch=writeBatch(db);

batch.set(doc(db,"bookings",id),data);

batch.set(doc(db,"tracking",id),{
id,
status:"নতুন বুকিং",
visitDate:"",
visitTime:"",
note:""
});

await batch.commit();

$("bookingId").textContent=id;
$("result").style.display="block";
$("bookingForm").reset();
window.scrollTo(0,document.body.scrollHeight);

}catch(error){
alert("বুকিং জমা হয়নি: "+error.message);
console.error(error);
}finally{
btn.disabled=false;
btn.textContent="বুকিং জমা দিন";
}
});

window.trackBooking=async()=>{
const id=$("trackId").value.trim();
if(!id){alert("বুকিং আইডি লিখুন");return;}

$("trackResult").textContent="খোঁজা হচ্ছে...";

try{
const snap=await getDoc(doc(db,"tracking",id));

if(!snap.exists()){
$("trackResult").textContent="বুকিং পাওয়া যায়নি।";
return;
}

const d=snap.data();
$("trackResult").innerHTML=
"স্ট্যাটাস: "+d.status+
"<br>কাজ দেখতে আসার তারিখ: "+(d.visitDate||"এখনো নির্ধারণ হয়নি")+
"<br>সময়: "+(d.visitTime||"নির্ধারণ হয়নি")+
"<br>নোট: "+(d.note||"নেই");

}catch(error){
$("trackResult").textContent="সমস্যা হয়েছে: "+error.message;
}
};

const dateInput=$("date");
const today=new Date();
dateInput.min=
today.getFullYear()+"-"+
String(today.getMonth()+1).padStart(2,"0")+"-"+
String(today.getDate()).padStart(2,"0");
</script>
</body>
</html>
